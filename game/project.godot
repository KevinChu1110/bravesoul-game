; Engine configuration file.
; Godot 4.7 — 勇者之魂
config_version=5

[application]
config/name="勇者之魂"
config/description="Story-first pixel RPG. Most battles breathe—boss battles remember."
config/version="0.15.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
## 字型要最早掛：它改的是 ThemeDB 預設，晚於 UI 建立就來不及
GameFont="*res://scripts/autoload/game_font.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
DisplaySettings="*res://scripts/autoload/display_settings.gd"
Loc="*res://scripts/autoload/loc.gd"
RiftSchedule="*res://scripts/systems/rift_schedule.gd"
TitleCatalog="*res://scripts/systems/title_catalog.gd"
SoulSystem="*res://scripts/systems/soul_system.gd"
SkillSystem="*res://scripts/systems/skill_system.gd"
QuestSystem="*res://scripts/systems/quest_system.gd"
GuildSystem="*res://scripts/systems/guild_system.gd"
TutorialSystem="*res://scripts/systems/tutorial_system.gd"
InventorySystem="*res://scripts/systems/inventory_system.gd"
DataTables="*res://scripts/systems/data_tables.gd"
GameLog="*res://scripts/systems/game_log.gd"
EquipmentSystem="*res://scripts/systems/equipment_system.gd"
UiLayout="*res://scripts/ui/ui_layout.gd"
OnlineGate="*res://scripts/autoload/online_gate.gd"
HuntSystem="*res://scripts/systems/hunt_system.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=3
window/size/resizable=true
window/size/borderless=false
window/size/always_on_top=false
window/size/initial_position_type=1

