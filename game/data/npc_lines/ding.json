{
  "id": "ding",
  "speaker": "釘釘",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1
      },
      "lines": [
        "又來？刃上的灰……你沾焰了？算了，我養器，不養命。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "鐵還在就好。——別再讓我認第二次葬過的鐵。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_done"
        ]
      },
      "lines": [
        "舊債還了。爐火……比以前穩一點。",
        "升階還是要錢。感情不能當炭燒。"
      ]
    },
    {
      "when": {
        "flags": [
          "item.broken_blade"
        ]
      },
      "lines": [
        "那斷口……你從演武場撿的？給我。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_asked"
        ]
      },
      "lines": [
        "斷劍還在演武場的武器架附近。別跟我說你迷路。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "微末之刃。名字難聽，好用就行。要升階拿金幣來。",
        "……有空的話，演武場那邊，幫我看一眼。舊債。"
      ]
    },
    {
      "when": {},
      "lines": [
        "門開著不是讓兔子觀光的。"
      ]
    }
  ]
}
