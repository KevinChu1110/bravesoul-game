{
  "id": "wind_ear_idle",
  "speaker": "风耳",
  "rules": [
    {
      "when": {
        "flags": [
          "boss.shadowwind_cleared"
        ]
      },
      "lines": [
        "风肯停了。你的耳朵比弓还准。",
        "海岸还在吼。去或不去，看你。"
      ]
    },
    {
      "when": {
        "flags": [
          "c4_entered"
        ]
      },
      "lines": [
        "疾影不会等你。真身会等，短短一瞬。",
        "别追残影。等停拍，再射。"
      ]
    },
    {
      "when": {},
      "lines": [
        "森林认脚步，不认名。你走得慢，很好。"
      ]
    }
  ]
}
