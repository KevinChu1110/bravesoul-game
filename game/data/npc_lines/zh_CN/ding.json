{
  "id": "ding",
  "speaker": "钉钉",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1
      },
      "lines": [
        "又来？刃上的灰……你沾焰了？算了，我养器，不养命。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "铁还在就好。——别再让我认第二次葬过的铁。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_done"
        ]
      },
      "lines": [
        "旧债还了。炉火……比以前稳一点。",
        "升阶还是要钱。感情不能当炭烧。"
      ]
    },
    {
      "when": {
        "flags": [
          "item.broken_blade"
        ]
      },
      "lines": [
        "那断口……你从演武场捡的？给我。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_asked"
        ]
      },
      "lines": [
        "断剑还在演武场的武器架附近。别跟我说你迷路。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "微末之刃。名字难听，好用就行。要升阶拿金币来。",
        "……有空的话，演武场那边，帮我看一眼。旧债。"
      ]
    },
    {
      "when": {},
      "lines": [
        "门开着不是让兔子观光的。"
      ]
    }
  ]
}
