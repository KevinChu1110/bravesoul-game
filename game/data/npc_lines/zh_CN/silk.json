        ]
      },
      "lines": [
        "黑焰以野心为食。麥穗的字……比典籍真。",
        "民間版说：第一位至弱者進了塔。官方版刪了后半句。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "微末之刃？釘釘还肯认铁，世界就还沒完。",
        "档案庫门后：黑焰三说、騎士团解散令、以及一張被撕掉的『至弱』頁。"
      ]
    },
    {
      "when": {},
      "lines": [
        "新面孔。逃難？佣兵外包？还是来对号入座當『至弱者』的？",
        "战后二十年，預言版本比刀还乱。別急著自称——先读完矛盾處。"
      ]
