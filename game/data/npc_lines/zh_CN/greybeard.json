{
  "id": "greybeard",
  "speaker": "灰须",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "又一次。脚印叠在旧路上。你还记得第一次拔剑拔了三次吗？",
        "回响里的狮子更躁。格挡别松。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔塌了一角。你却还站着。……哼。进来喝茶。",
        "招式若还要长，旅途养招还在。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "雾也看破了？眼睛比剑先长。",
        "塔在等。别学把焰当柴的傻子。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "（背影）门为你开。",
        "东南有雾。信会慢——人别慢。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃有了。内殿的狮子不听人话，听刀。",
        "你不是去证明你强。你是去让它想起该守什么。"
      ]
    },
    {
      "when": {},
      "lines": [
        "圣狮在内殿。你若不是送死，就先把剑养好。",
        "招式不是看的。打中了才会长。"
      ]
    }
  ]
}
