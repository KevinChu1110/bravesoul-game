{
  "id": "greybeard",
  "speaker": "灰须",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "又一次。腳印疊在旧路上。你还記得第一次拔剑拔了三次嗎？",
        "迴響里的獅子更躁。格擋別鬆。——佣兵第二课：重複的路，更要專心。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔塌了一角。你卻还站著。……哼。進来喝茶。",
        "团里大概还當你是最弱的。堡里的人已經不那么想了。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧也看破了？眼睛比剑先长。",
        "塔在等。別學把焰當柴的傻子——也別急著自称勇者。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "（背影）门为你开。",
        "東南有霧。信會慢——人別慢。回报给团里的話，写清楚：你还活著。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃有了。內殿的獅子不聽人話，聽刀。",
        "你不是去證明你強。你是去讓它想起該守什么。——这比佣兵任務单上的字重要。"
      ]
    },
    {
      "when": {},
      "lines": [
        "佣兵团最弱的？聖獅在內殿。你若不是送死，就先把剑養好。",
        "招式不是看的。打中了才會长。活著回报，比漂亮的軍功章重要。"
      ]
    }
  ]
}
