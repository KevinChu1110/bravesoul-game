{
  "id": "ding",
  "speaker": "釘釘",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1
      },
      "lines": [
        "また来たか？刃の灰……炎に触れたな？まあいい、俺は器を育てる。命は育てん。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "鉄が残ってるならいい。——同じ鉄を二度葬らせるなよ。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_done"
        ]
      },
      "lines": [
        "古い借りは返した。炉の火が……前より少し落ち着いた。",
        "階位上げには金がいる。情は炭にならん。"
      ]
    },
    {
      "when": {
        "flags": [
          "item.broken_blade"
        ]
      },
      "lines": [
        "その折れ口……演武場で拾ったな？よこせ。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.ding_debt_asked"
        ]
      },
      "lines": [
        "折れた剣は演武場の武器架のあたりだ。道に迷ったとは言うなよ。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "微末の刃。名は不格好だが、使えりゃいい。階位を上げたきゃ金を持ってこい。",
        "……暇があったら、演武場のほうを見てきてくれ。古い借りだ。"
      ]
    },
    {
      "when": {},
      "lines": [
        "扉が開いてるのは兎の見物のためじゃない。"
      ]
    }
  ]
}
