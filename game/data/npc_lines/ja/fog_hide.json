{
  "id": "fog_hide",
  "speaker": "霧隠",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "二周目の霧はもっとよく笑う。本体が白く光るまで、焦るな。"
      ]
    },
    {
      "when": {
        "flags": [
          "side.fog_letter_done"
        ]
      },
      "lines": [
        "本物の手紙は届いた。偽の霧が一枚薄くなった。",
        "お前の目、最初より使えるようになったな。"
      ]
    },
    {
      "when": {
        "flags": [
          "item.true_letter"
        ]
      },
      "lines": [
        "手紙はお前が持っている。岔路の行商宿駅で、本物を渡せ。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧は晴れた。お前の目は、まあ使える。",
        "……もう一通、本物がある。偽が多すぎる。本物は手ずから届けるものだ。"
      ]
    },
    {
      "when": {
        "flags": [
          "c2_wheat_letter"
        ]
      },
      "lines": [
        "影を斬れば、影が笑う。破綻を見ろ：刃が持ち上がる一瞬こそが本物だ。",
        "幻廊は村の東。白霧はお前が迷うのを待っている。"
      ]
    },
    {
      "when": {},
      "lines": [
        "まず宿へ行け。手紙をここまで回した者がいる……遅かったがな。"
      ]
    }
  ]
}
