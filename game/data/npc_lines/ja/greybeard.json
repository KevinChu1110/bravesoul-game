{
  "id": "greybeard",
  "speaker": "灰鬚",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "また一度。足跡が古い道に重なる。最初、剣を三度引いてやっと抜けたのを覚えてるか？",
        "残響の獅子はもっと荒い。パリィを緩めるな。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔が一角崩れた。それでもお前は立っている。……ふん。入って茶でも飲め。",
        "技をまだ伸ばしたいなら、旅の稽古はまだ開いている。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧まで見破ったか？目は剣より先に育つものだ。",
        "塔が待っている。炎を薪と間違える愚か者の真似はするな。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "（背を向けて）門はお前のために開く。",
        "南東に霧がある。手紙は遅れる——人は遅れるな。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃は手に入れたな。内殿の獅子は人の言葉を聞かん。刀を聞く。",
        "お前は自分の強さを証明しに行くんじゃない。あれに、何を守るべきだったかを思い出させに行くんだ。"
      ]
    },
    {
      "when": {},
      "lines": [
        "聖獅は内殿にいる。死にに行くのでなければ、まず剣を育てろ。",
        "技は眺めるものじゃない。当てて初めて伸びる。"
      ]
    }
  ]
}
