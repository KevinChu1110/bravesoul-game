{
  "id": "wind_ear_idle",
  "speaker": "風耳",
  "rules": [
    {
      "when": {
        "flags": [
          "boss.shadowwind_cleared"
        ]
      },
      "lines": [
        "風肯停了。你的耳朵比弓還準。",
        "海岸還在吼。去或不去，看你。團裡沒規定你非去不可。"
      ]
    },
    {
      "when": {
        "flags": [
          "c4_entered"
        ]
      },
      "lines": [
        "疾影不會等頭銜。真身會等，短短一瞬。",
        "別追殘影。等停拍，再射。——比漂亮的軍功重要。"
      ]
    },
    {
      "when": {},
      "lines": [
        "森林認腳步，不認頭銜。你走得慢，很好。傭兵團最弱的？林裡只認停拍。"
      ]
    }
  ]
}
