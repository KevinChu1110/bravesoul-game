{
  "id": "wind_ear_idle",
  "speaker": "風耳",
  "rules": [
    {
      "when": {
        "flags": [
          "boss.shadowwind_cleared"
        ]
      },
      "lines": [
        "風肯停了。你的耳朵……比弓還準。",
        "海岸還在吼。去或不去，看你。"
      ]
    },
    {
      "when": {
        "flags": [
          "c4_entered"
        ]
      },
      "lines": [
        "疾影不會等你。但真身會——短短一瞬。",
        "別追殘影。等停拍，再射。"
      ]
    },
    {
      "when": {},
      "lines": [
        "森林認腳步，不認名。你走得慢——很好。"
      ]
    }
  ]
}
