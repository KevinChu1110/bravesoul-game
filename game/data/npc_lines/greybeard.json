{
  "id": "greybeard",
  "speaker": "灰鬚",
  "rules": [
    {
      "when": {
        "ng_plus_min": 1,
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "又一次。腳印疊在舊路上——你還記得第一次拔劍拔了三次嗎？",
        "迴響裡的獅子更躁。格擋別鬆。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.demon_cleared"
        ]
      },
      "lines": [
        "塔塌了一角。你卻還站著。……哼。進來喝茶。",
        "招式若還要長，旅途養招還在。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared",
          "boss.white_fog_cleared"
        ]
      },
      "lines": [
        "霧也看破了？眼睛比劍先長。",
        "塔在等。別學把焰當柴的傻子。"
      ]
    },
    {
      "when": {
        "flags": [
          "boss.leo_cleared"
        ]
      },
      "lines": [
        "（背影）門為你開。",
        "東南有霧。信會慢——人別慢。"
      ]
    },
    {
      "when": {
        "flags": [
          "c1_forged"
        ]
      },
      "lines": [
        "刃有了。內殿的獅子不聽人話，聽刀。",
        "你不是去證明你強。你是去讓它想起該守什麼。"
      ]
    },
    {
      "when": {},
      "lines": [
        "聖獅在內殿。你若不是送死，就先把劍養好。",
        "招式不是看的。打中了才會長。"
      ]
    }
  ]
}
